{
  "name": "folio-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "studio": "vite --open /studio/",
    "content:check": "node scripts/check-content.mjs",
    "content:sync": "node scripts/sync-content-registry.mjs",
    "content:new": "node scripts/new-content-project.mjs",
    "content:reset": "node scripts/reset-content.mjs",
    "images:sync": "node scripts/sync-image-manifest.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run content:sync && npm run images:sync && npm run content:check && npm run typecheck && npm run assets:check",
    "assets:optimize": "node scripts/optimize-images.mjs",
    "assets:share-covers": "node scripts/generate-share-covers.mjs",
    "assets:check": "node scripts/check-asset-budget.mjs",
    "build": "npm run verify && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "jose": "^6.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-markdown": "^10.1.0",
    "react-to-print": "^3.2.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
